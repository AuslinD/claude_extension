{
  "manifest_version": 3,
  "name": "Claude Chat Colors",
  "version": "1.2.0",
  "description": "Color-code your claude.ai chats, see which chats are still running, and track your time prompting, waiting and reading.",
  "permissions": [
    "storage"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Claude Chat Colors",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*"
      ],
      "js": [
        "src/colors.js",
        "src/selectors.js",
        "src/status.js",
        "src/activity.js",
        "src/storage.js",
        "src/api.js",
        "src/inbox.js",
        "src/palette-ui.js",
        "src/content.js"
      ],
      "css": [
        "src/content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "toggle-tracking-pause": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      },
      "description": "Pause / resume time tracking"
    }
  }
}
