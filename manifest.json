{
  "manifest_version": 3,
  "name": "Claude Chat Colors",
  "version": "1.1.0",
  "description": "Color-code your claude.ai chats and see at a glance which chats are still running.",
  "permissions": [
    "storage"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Claude Chat Colors",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*"
      ],
      "js": [
        "src/colors.js",
        "src/selectors.js",
        "src/status.js",
        "src/storage.js",
        "src/api.js",
        "src/palette-ui.js",
        "src/content.js"
      ],
      "css": [
        "src/content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
